# Development defaults. Do not use these values in staging or production.
NODE_ENV=development
PROCESS_ROLE=api

# Database connection stays in this file. It is not editable from Admin > Settings.
# Runtime role is NOSUPERUSER and cannot bypass row-level security.
DATABASE_URL=postgresql://app_user:app_password@localhost:5433/vendor_portal
# Migrations, grants, and seed run as the table owner.
MIGRATE_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/vendor_portal

REDIS_URL=redis://localhost:6379
# inline processes the transactional outbox in the API process.
# queue publishes to BullMQ and requires the worker process.
JOBS_MODE=inline

API_PORT=3001
WEB_ORIGIN=http://localhost:3000
API_PROXY_URL=http://localhost:3001
COOKIE_SECURE=false

# 32-byte key, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# This development key is not a secret. Replace it outside local development.
APP_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Session length, invitation expiry, upload size, import row limit, email, and
# Railway storage (endpoint, region, bucket, access key, secret) are saved in
# Admin > Settings. On Railway, ENDPOINT, REGION, BUCKET, ACCESS_KEY_ID, and
# SECRET_ACCESS_KEY are copied into settings on startup. They are not set here.

EMAIL_WEBHOOK_SECRET=dev-email-webhook-secret

# Gap between real SMTP sends. Hostinger allows about 15 messages a minute;
# 5000 sends one every 5 seconds (12 a minute) and leaves the rest queued.
# localhost and the json test host are not delayed. Set to 0 to disable the gap.
SMTP_MIN_INTERVAL_MS=5000

# Optional second mail server. Used only when the saved SMTP server rejects a message.
# Leave the host empty to retry the saved server with backoff instead.
SMTP_FALLBACK_HOST=
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_SECURE=false
SMTP_FALLBACK_USER=
SMTP_FALLBACK_PASS=
SMTP_FALLBACK_FROM=

# Optional ClamAV daemon. Leave empty to use the built-in signature scanner.
CLAMAV_HOST=
CLAMAV_PORT=3310

ENABLE_SWAGGER=true
ENABLE_TEST_HOOKS=false

SEED_ADMIN_EMAIL=admin@harbor.example
SEED_ADMIN_PASSWORD=ChangeMe!Admin1
SEED_REVIEWER_EMAIL=reviewer@harbor.example
SEED_REVIEWER_PASSWORD=ChangeMe!Review1
