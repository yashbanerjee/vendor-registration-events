generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATE_DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum VendorStatus {
  ACTIVE
  INVITED
  SUSPENDED
  ARCHIVED
}

enum ExhibitionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FormScope {
  GLOBAL
  EXHIBITION
  VENDOR
}

enum FormTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssignmentStatus {
  INVITED
  IN_PROGRESS
  SUBMITTED_PENDING_REVIEW
  CORRECTION_REQUESTED
  RESUBMITTED_PENDING_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
  EXPIRED
  REVOKED
}

enum InvitationPurpose {
  ACCOUNT_ACTIVATION
  FORM_ASSIGNMENT
  CORRECTION
  PASSWORD_RESET
}

enum CorrectionStatus {
  OPEN
  RESOLVED
  SUPERSEDED
}

enum DocumentStatus {
  QUARANTINED
  AVAILABLE
  REJECTED
  ARCHIVED
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ImportRowStatus {
  CREATED
  SKIPPED
  ERROR
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users        User[]
  vendors      Vendor[]
  exhibitions  Exhibition[]
  templates    FormTemplate[]
  versions     FormVersion[]
  assignments  FormAssignment[]
  invitations  Invitation[]
  submissions  Submission[]
  revisions    SubmissionRevision[]
  corrections  CorrectionRequest[]
  documents    Document[]
  notifications Notification[]
  emails       EmailMessage[]
  outbox       OutboxEvent[]
  audits       AuditLog[]
  imports      ImportJob[]
  reviewNotes  ReviewNote[]

  @@map("organizations")
}

model Permission {
  id    String @id @default(uuid()) @db.Uuid
  key   String @unique
  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  email          String
  name           String
  passwordHash   String?    @map("password_hash")
  status         UserStatus @default(INVITED)
  vendorId       String?    @map("vendor_id") @db.Uuid
  mfaEnabled     Boolean    @default(false) @map("mfa_enabled")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  vendor       Vendor?      @relation(fields: [vendorId], references: [id])
  roles        UserRole[]
  sessions     Session[]
  mfa          MfaSecret?
  mfaChallenges MfaChallenge[]
  notifications Notification[]

  @@unique([organizationId, id])
  @@unique([email])
  @@index([organizationId, status])
  @@map("users")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  csrfHash  String    @map("csrf_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model MfaSecret {
  userId      String    @id @map("user_id") @db.Uuid
  secretEnc   String    @map("secret_enc")
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_secrets")
}

model MfaChallenge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_challenges")
}

model Vendor {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  reference        String
  companyName      String       @map("company_name")
  contactName      String       @map("contact_name")
  email            String
  additionalEmails String[]     @default([]) @map("additional_emails")
  phone            String       @default("")
  addressLine1     String       @default("") @map("address_line1")
  addressLine2     String       @default("") @map("address_line2")
  city             String       @default("")
  region           String       @default("")
  postalCode       String       @default("") @map("postal_code")
  country          String       @default("")
  category         String       @default("")
  status           VendorStatus @default(INVITED)
  archivedAt       DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id])
  users        User[]
  exhibitions  VendorExhibition[]
  assignments  FormAssignment[]
  documents    Document[]
  templates    FormTemplate[]

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@unique([organizationId, email])
  @@index([organizationId, companyName])
  @@index([organizationId, status])
  @@map("vendors")
}

model Exhibition {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String
  code           String
  venue          String           @default("")
  description    String           @default("")
  startsAt       DateTime         @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime         @map("ends_at") @db.Timestamptz(6)
  status         ExhibitionStatus @default(DRAFT)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id])
  vendors      VendorExhibition[]
  assignments  FormAssignment[]
  templates    FormTemplate[]
  documents    Document[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, startsAt])
  @@map("exhibitions")
}

model VendorExhibition {
  organizationId String   @map("organization_id") @db.Uuid
  vendorId       String   @map("vendor_id") @db.Uuid
  exhibitionId   String   @map("exhibition_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  vendor     Vendor     @relation(fields: [organizationId, vendorId], references: [organizationId, id], onDelete: Cascade)
  exhibition Exhibition @relation(fields: [organizationId, exhibitionId], references: [organizationId, id], onDelete: Cascade)

  @@id([vendorId, exhibitionId])
  @@index([organizationId])
  @@map("vendor_exhibitions")
}

model FormTemplate {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  name           String
  description    String             @default("")
  scope          FormScope          @default(GLOBAL)
  status         FormTemplateStatus @default(DRAFT)
  exhibitionId   String?            @map("exhibition_id") @db.Uuid
  vendorId       String?            @map("vendor_id") @db.Uuid
  draftSchema    Json               @map("draft_schema")
  createdById    String             @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt     DateTime?          @map("archived_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  exhibition   Exhibition?  @relation(fields: [exhibitionId], references: [id])
  vendor       Vendor?      @relation(fields: [vendorId], references: [id])
  versions     FormVersion[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("form_templates")
}

model FormVersion {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  templateId     String   @map("template_id") @db.Uuid
  versionNumber  Int      @map("version_number")
  schema         Json
  checksum       String
  publishedById  String   @map("published_by_id") @db.Uuid
  publishedAt    DateTime @default(now()) @map("published_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id])
  template     FormTemplate     @relation(fields: [organizationId, templateId], references: [organizationId, id])
  assignments  FormAssignment[]
  revisions    SubmissionRevision[]

  @@unique([organizationId, id])
  @@unique([templateId, versionNumber])
  @@map("form_versions")
}

model FormAssignment {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  vendorId        String           @map("vendor_id") @db.Uuid
  exhibitionId    String           @map("exhibition_id") @db.Uuid
  formVersionId   String           @map("form_version_id") @db.Uuid
  status          AssignmentStatus @default(INVITED)
  deadline        DateTime?        @db.Timestamptz(6)
  lockVersion     Int              @default(0) @map("lock_version")
  submittedAt     DateTime?        @map("submitted_at") @db.Timestamptz(6)
  approvedAt      DateTime?        @map("approved_at") @db.Timestamptz(6)
  approvedById    String?          @map("approved_by_id") @db.Uuid
  approvedRevisionId String?       @map("approved_revision_id") @db.Uuid
  createdById     String           @map("created_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  vendor       Vendor       @relation(fields: [organizationId, vendorId], references: [organizationId, id])
  exhibition   Exhibition   @relation(fields: [organizationId, exhibitionId], references: [organizationId, id])
  formVersion  FormVersion  @relation(fields: [organizationId, formVersionId], references: [organizationId, id])
  invitations  Invitation[]
  submission   Submission?
  documents    Document[]

  @@unique([organizationId, id])
  @@unique([vendorId, exhibitionId, formVersionId])
  @@index([organizationId, status])
  @@index([organizationId, deadline])
  @@map("form_assignments")
}

model Invitation {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  purpose        InvitationPurpose
  email          String
  tokenHash      String             @unique @map("token_hash")
  vendorId       String?            @map("vendor_id") @db.Uuid
  assignmentId   String?            @map("assignment_id") @db.Uuid
  userId         String?            @map("user_id") @db.Uuid
  expiresAt      DateTime           @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime?          @map("used_at") @db.Timestamptz(6)
  revokedAt      DateTime?          @map("revoked_at") @db.Timestamptz(6)
  createdById    String?            @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id])
  assignment   FormAssignment? @relation(fields: [assignmentId], references: [id])

  @@index([organizationId, assignmentId, purpose])
  @@index([email])
  @@map("invitations")
}

model Submission {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  assignmentId      String   @unique @map("assignment_id") @db.Uuid
  currentRevisionId String?  @map("current_revision_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id])
  assignment   FormAssignment       @relation(fields: [organizationId, assignmentId], references: [organizationId, id])
  revisions    SubmissionRevision[]
  corrections  CorrectionRequest[]
  notes        ReviewNote[]

  @@unique([organizationId, id])
  @@unique([organizationId, assignmentId])
  @@map("submissions")
}

model SubmissionRevision {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  submissionId   String   @map("submission_id") @db.Uuid
  formVersionId  String   @map("form_version_id") @db.Uuid
  revisionNumber Int      @map("revision_number")
  data           Json
  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  submission   Submission   @relation(fields: [organizationId, submissionId], references: [organizationId, id])
  formVersion  FormVersion  @relation(fields: [organizationId, formVersionId], references: [organizationId, id])

  @@unique([submissionId, revisionNumber])
  @@index([organizationId, createdAt])
  @@map("submission_revisions")
}

model CorrectionRequest {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  submissionId   String           @map("submission_id") @db.Uuid
  revisionId     String           @map("revision_id") @db.Uuid
  status         CorrectionStatus @default(OPEN)
  requestedById  String           @map("requested_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  submission   Submission   @relation(fields: [organizationId, submissionId], references: [organizationId, id])
  fields       CorrectionRequestField[]

  @@index([organizationId, status])
  @@map("correction_requests")
}

model CorrectionRequestField {
  id                  String @id @default(uuid()) @db.Uuid
  organizationId      String @map("organization_id") @db.Uuid
  correctionRequestId String @map("correction_request_id") @db.Uuid
  fieldId             String @map("field_id")
  note                String

  correctionRequest CorrectionRequest @relation(fields: [correctionRequestId], references: [id], onDelete: Cascade)

  @@unique([correctionRequestId, fieldId])
  @@index([organizationId])
  @@map("correction_request_fields")
}

model ReviewNote {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  submissionId   String   @map("submission_id") @db.Uuid
  authorId       String   @map("author_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  submission   Submission   @relation(fields: [organizationId, submissionId], references: [organizationId, id])

  @@index([submissionId, createdAt])
  @@map("review_notes")
}

model Document {
  id                   String         @id @default(uuid()) @db.Uuid
  organizationId       String         @map("organization_id") @db.Uuid
  vendorId             String         @map("vendor_id") @db.Uuid
  exhibitionId         String?        @map("exhibition_id") @db.Uuid
  assignmentId         String?        @map("assignment_id") @db.Uuid
  submissionRevisionId String?        @map("submission_revision_id") @db.Uuid
  fieldId              String?        @map("field_id")
  category             String         @default("form-upload")
  status               DocumentStatus @default(QUARANTINED)
  retentionUntil       DateTime?      @map("retention_until") @db.Timestamptz(6)
  archivedAt           DateTime?      @map("archived_at") @db.Timestamptz(6)
  deletedAt            DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id])
  vendor       Vendor            @relation(fields: [organizationId, vendorId], references: [organizationId, id])
  exhibition   Exhibition?       @relation(fields: [exhibitionId], references: [id])
  assignment   FormAssignment?   @relation(fields: [assignmentId], references: [id])
  versions     DocumentVersion[]

  @@unique([organizationId, id])
  @@index([organizationId, vendorId, createdAt])
  @@index([organizationId, status])
  @@map("documents")
}

model DocumentVersion {
  id           String   @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  versionNumber Int     @map("version_number")
  storageKey   String   @map("storage_key")
  filename     String
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  checksum     String
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  scanStatus   String   @default("pending") @map("scan_status")
  scanDetails  String   @default("") @map("scan_details")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([organizationId, filename])
  @@map("document_versions")
}

model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  title          String
  body           String
  link           String    @default("")
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model EmailMessage {
  id                String      @id @default(uuid()) @db.Uuid
  organizationId    String      @map("organization_id") @db.Uuid
  toAddress         String      @map("to_address")
  template          String
  subject           String
  status            EmailStatus @default(QUEUED)
  idempotencyKey    String      @unique @map("idempotency_key")
  providerMessageId String?     @map("provider_message_id")
  attemptCount      Int         @default(0) @map("attempt_count")
  lastError         String      @default("") @map("last_error")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id])
  events       EmailDeliveryEvent[]

  @@index([organizationId, status])
  @@map("email_messages")
}

model EmailDeliveryEvent {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  emailMessageId String      @map("email_message_id") @db.Uuid
  status         EmailStatus
  source         String
  payload        Json
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  email EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@index([emailMessageId, createdAt])
  @@map("email_delivery_events")
}

model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  type           String
  payloadEnc     String       @map("payload_enc")
  status         OutboxStatus @default(PENDING)
  idempotencyKey String       @unique @map("idempotency_key")
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  lastError      String       @default("") @map("last_error")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([status, availableAt])
  @@map("outbox_events")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  actorRole      String   @default("") @map("actor_role")
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String   @map("resource_id")
  vendorId       String?  @map("vendor_id") @db.Uuid
  fieldId        String?  @map("field_id")
  previousValue  Json?    @map("previous_value")
  newValue       Json?    @map("new_value")
  correlationId  String   @default("") @map("correlation_id")
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, resourceType, resourceId])
  @@index([organizationId, vendorId])
  @@map("audit_logs")
}

model ImportJob {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  createdById    String       @map("created_by_id") @db.Uuid
  filename       String
  fileSha256     String       @map("file_sha256")
  status         ImportStatus @default(PENDING)
  totalRows      Int          @default(0) @map("total_rows")
  createdCount   Int          @default(0) @map("created_count")
  skippedCount   Int          @default(0) @map("skipped_count")
  errorCount     Int          @default(0) @map("error_count")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id])
  rows         ImportJobRow[]

  @@index([organizationId, createdAt])
  @@map("import_jobs")
}

model ImportJobRow {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  importJobId    String          @map("import_job_id") @db.Uuid
  rowNumber      Int             @map("row_number")
  status         ImportRowStatus
  payload        Json
  messages       String[]        @default([])
  vendorId       String?         @map("vendor_id") @db.Uuid

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@unique([importJobId, rowNumber])
  @@index([organizationId])
  @@map("import_job_rows")
}
